# Neon connection string (use the pooled one for the web app)
DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
OWNER_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string
# Encrypts the stored YouTube refresh token. Keep stable; changing it requires reconnecting YouTube.
ENCRYPTION_KEY=generate-another-long-random-string
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# tts: mock | openai | elevenlabs
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=
# images: mock | pexels
IMAGE_PROVIDER=mock
PEXELS_API_KEY=
# transcripts: mock | openai
TRANSCRIPT_PROVIDER=mock
OPENAI_API_KEY=
# OpenAI voice (TTS_PROVIDER=openai). Voices: alloy, ash, coral, echo, fable, onyx, nova, sage, shimmer (availability depends on model)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
OPENAI_TTS_INSTRUCTIONS=
STORAGE_DIR=./storage
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
MONTHLY_BUDGET_USD=50

# Providers: set to mock only for offline dev/tests. LLM_PROVIDER=mock | YOUTUBE_PROVIDER=mock | ANALYTICS_PROVIDER=mock
# Worker polling interval. On Neon, polling keeps compute awake; raise this (e.g. 15000) to let it scale to zero.
WORKER_POLL_MS=2000
ERROR_WEBHOOK_URL=
LOG_LEVEL=info
