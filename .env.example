# Neon connection string (use the pooled one for the web app)
DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
OWNER_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string
# Encrypts the stored YouTube refresh token. Keep stable; changing it requires reconnecting YouTube.
ENCRYPTION_KEY=generate-another-long-random-string
ANTHROPIC_API_KEY=
# Model routing (effort is low by default for main + visual)
# main: ideas, scripts, titles | visual: visual direction + thumbnail concepts | light: judges, summaries
MODEL_MAIN=claude-opus-5-5
MODEL_VISUAL=claude-fable-5-2
MODEL_LIGHT=claude-sonnet-5-5
EFFORT_MAIN=low
EFFORT_VISUAL=low
# tts: mock | openai | elevenlabs
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=
# Flash v2.5 = 0.5 credit/char (~4,500 credits per 10 min). eleven_multilingual_v2 = 1 credit/char.
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_MAX_CREDITS_PER_VIDEO=4500
# Max share of a new script's 6-word phrases that may repeat earlier scripts
MAX_SCRIPT_OVERLAP=0.08
# images: mock | pexels
IMAGE_PROVIDER=mock
PEXELS_API_KEY=
# transcripts: mock | openai
TRANSCRIPT_PROVIDER=mock
OPENAI_API_KEY=
# OpenAI voice (TTS_PROVIDER=openai). Voices: alloy, ash, coral, echo, fable, onyx, nova, sage, shimmer (availability depends on model)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
OPENAI_TTS_INSTRUCTIONS=
STORAGE_DIR=./storage
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
MONTHLY_BUDGET_USD=50

# Providers: set to mock only for offline dev/tests. LLM_PROVIDER=mock | YOUTUBE_PROVIDER=mock | ANALYTICS_PROVIDER=mock
# Worker polling interval. On Neon, polling keeps compute awake; raise this (e.g. 15000) to let it scale to zero.
WORKER_POLL_MS=2000
ERROR_WEBHOOK_URL=
LOG_LEVEL=info

# Visuals
# Stock footage: VIDEO_PROVIDER=pexels (needs PEXELS_API_KEY) | mock | unset = stills only
VIDEO_PROVIDER=
# AI-generated stills that get animated: AI_IMAGE_PROVIDER=openai (needs OPENAI_API_KEY) | mock
AI_IMAGE_PROVIDER=mock
OPENAI_IMAGE_MODEL=gpt-image-1
# Estimated USD per generated image: set from OpenAI's current pricing for your model/size
OPENAI_IMAGE_USD_EACH=0.07
# Max AI images per video (cost control)
AI_MAX_PER_VIDEO=2
# Hard stops: spending jobs wait instead of passing these
PER_VIDEO_BUDGET_USD=3
